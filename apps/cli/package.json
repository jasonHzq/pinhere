{
  "name": "@pinhere/cli",
  "version": "0.1.0",
  "description": "Pair local coding agents with Pinhere and process browser-reported issues.",
  "type": "module",
  "bin": { "pinhere": "dist/index.js" },
  "files": ["dist", "skill"],
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=22.14.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "lint": "tsc --noEmit --pretty false",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.19.11",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
