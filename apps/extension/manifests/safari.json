{
  "manifest_version": 3,
  "name": "Pinhere for Safari",
  "short_name": "Pinhere",
  "description": "在 iPhone、iPad 和 Mac 的 Safari 中圈选网页问题，并发送 DOM 与截图。",
  "version": "0.1.1",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": ["https://pinhere.dev/*", "https://pinhere-delta.vercel.app/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "打开 Pinhere",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/pinhere-16.png",
      "19": "icons/pinhere-19.png",
      "32": "icons/pinhere-32.png",
      "38": "icons/pinhere-38.png",
      "48": "icons/pinhere-48.png",
      "128": "icons/pinhere-128.png"
    }
  },
  "icons": {
    "16": "icons/pinhere-16.png",
    "19": "icons/pinhere-19.png",
    "32": "icons/pinhere-32.png",
    "38": "icons/pinhere-38.png",
    "48": "icons/pinhere-48.png",
    "64": "icons/pinhere-64.png",
    "96": "icons/pinhere-96.png",
    "128": "icons/pinhere-128.png",
    "256": "icons/pinhere-256.png",
    "512": "icons/pinhere-512.png"
  },
  "browser_specific_settings": {
    "safari": { "strict_min_version": "15.4" }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
