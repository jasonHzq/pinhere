{
  "pontx": "2.1",
  "name": "pinhere-api",
  "style": "RESTFul",
  "info": {
    "title": "Pinhere API",
    "version": "1.0.0",
    "description": "Pinhere 项目、缺陷、附件与自动化接口。Pontx Hub 可直接消费此规范生成 SDK、CLI 与 Skill。"
  },
  "servers": [
    { "id": "production", "url": "https://pinhere.dev/api/v1", "description": "Pinhere 生产 API" }
  ],
  "security": [{ "bearerAuth": [] }],
  "tags": [
    { "name": "projects", "description": "项目与 Origin 归属" },
    { "name": "issues", "description": "缺陷和 AI 状态机" },
    { "name": "attachments", "description": "私有截图" },
    { "name": "webhooks", "description": "issue.created 通知" },
    { "name": "tokens", "description": "自动化调用凭证" }
  ],
  "apis": {
    "listProjects": { "operationId": "listProjects", "summary": "列出项目", "description": "列出当前账号的全部项目。", "method": "GET", "path": "/projects", "consumes": [], "produces": ["application/json"], "parameters": [], "responses": { "200": { "description": "项目列表。" } }, "tags": ["projects"] },
    "createProject": { "operationId": "createProject", "summary": "创建项目", "description": "创建个人项目并可同时设置 Origin。", "method": "POST", "path": "/projects", "consumes": ["application/json"], "produces": ["application/json"], "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }, { "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/components/schemas/ProjectInput" } }], "responses": { "201": { "description": "项目已创建。" }, "409": { "description": "Origin 已归属于其他项目。" } }, "tags": ["projects"] },
    "getProject": { "operationId": "getProject", "summary": "获取项目", "description": "获取项目和 Origin。", "method": "GET", "path": "/projects/{projectId}", "consumes": [], "produces": ["application/json"], "parameters": [{ "$ref": "#/components/parameters/ProjectId" }], "responses": { "200": { "description": "项目详情。" }, "404": { "description": "项目不存在。" } }, "tags": ["projects"] },
    "updateProject": { "operationId": "updateProject", "summary": "更新项目", "description": "使用 If-Match 和 version 更新项目。", "method": "PATCH", "path": "/projects/{projectId}", "consumes": ["application/json"], "produces": ["application/json"], "parameters": [{ "$ref": "#/components/parameters/ProjectId" }, { "$ref": "#/components/parameters/IfMatch" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "200": { "description": "项目已更新。" }, "412": { "description": "版本冲突。" } }, "tags": ["projects"] },
    "deleteProject": { "operationId": "deleteProject", "summary": "删除项目", "description": "删除项目、缺陷和截图。", "method": "DELETE", "path": "/projects/{projectId}", "consumes": [], "produces": [], "parameters": [{ "$ref": "#/components/parameters/ProjectId" }, { "$ref": "#/components/parameters/IfMatch" }], "responses": { "204": { "description": "项目已删除。" } }, "tags": ["projects"] },
    "addProjectOrigin": { "operationId": "addProjectOrigin", "summary": "添加 Origin", "description": "为项目添加标准化 Origin。", "method": "POST", "path": "/projects/{projectId}/origins", "consumes": ["application/json"], "produces": ["application/json"], "parameters": [{ "$ref": "#/components/parameters/ProjectId" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "201": { "description": "Origin 已添加。" }, "409": { "description": "Origin 已分配。" } }, "tags": ["projects"] },
    "deleteProjectOrigin": { "operationId": "deleteProjectOrigin", "summary": "删除 Origin", "description": "从项目删除 URL 编码后的 Origin。", "method": "DELETE", "path": "/projects/{projectId}/origins/{encodedOrigin}", "consumes": [], "produces": [], "parameters": [{ "$ref": "#/components/parameters/ProjectId" }, { "in": "path", "name": "encodedOrigin", "required": true, "schema": { "type": "string", "description": "URL 编码后的标准化 Origin。" } }], "responses": { "204": { "description": "Origin 已删除。" } }, "tags": ["projects"] },
    "resolveProject": { "operationId": "resolveProject", "summary": "按 URL 解析项目", "description": "只比较协议、域名和端口。", "method": "GET", "path": "/projects/resolve", "consumes": [], "produces": ["application/json"], "parameters": [{ "in": "query", "name": "url", "required": true, "schema": { "type": "string", "format": "uri", "description": "当前页面 URL。" } }], "responses": { "200": { "description": "返回匹配项目或 null。" } }, "tags": ["projects"] },

    "listIssues": { "operationId": "listIssues", "summary": "列出缺陷", "description": "游标分页并支持项目、状态和更新时间过滤。", "method": "GET", "path": "/issues", "consumes": [], "produces": ["application/json"], "parameters": [{ "$ref": "#/components/parameters/Cursor" }, { "in": "query", "name": "projectId", "required": false, "schema": { "type": "string" } }, { "in": "query", "name": "status", "required": false, "schema": { "$ref": "#/components/schemas/IssueStatus" } }, { "in": "query", "name": "updatedAfter", "required": false, "schema": { "type": "string", "format": "date-time" } }], "responses": { "200": { "description": "缺陷列表。" }, "304": { "description": "内容未变化。" } }, "tags": ["issues"] },
    "createIssue": { "operationId": "createIssue", "summary": "创建缺陷", "description": "创建缺陷并在同一事务写入 issue.created Outbox。", "method": "POST", "path": "/issues", "consumes": ["application/json"], "produces": ["application/json"], "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }, { "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/components/schemas/IssueInput" } }], "responses": { "201": { "description": "缺陷已创建。" }, "409": { "description": "页面 Origin 与项目不匹配。" } }, "tags": ["issues"] },
    "getIssue": { "operationId": "getIssue", "summary": "获取缺陷", "description": "获取 DOM、截图、目标与状态上下文。", "method": "GET", "path": "/issues/{issueId}", "consumes": [], "produces": ["application/json"], "parameters": [{ "$ref": "#/components/parameters/IssueId" }], "responses": { "200": { "description": "缺陷完整上下文。" }, "404": { "description": "缺陷不存在。" } }, "tags": ["issues"] },
    "updateIssue": { "operationId": "updateIssue", "summary": "更新缺陷", "description": "更新标题或描述。", "method": "PATCH", "path": "/issues/{issueId}", "consumes": ["application/json"], "produces": ["application/json"], "parameters": [{ "$ref": "#/components/parameters/IssueId" }, { "$ref": "#/components/parameters/IfMatch" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "200": { "description": "缺陷已更新。" }, "412": { "description": "版本冲突。" } }, "tags": ["issues"] },
    "deleteIssue": { "operationId": "deleteIssue", "summary": "删除缺陷", "description": "删除缺陷、历史与截图。", "method": "DELETE", "path": "/issues/{issueId}", "consumes": [], "produces": [], "parameters": [{ "$ref": "#/components/parameters/IssueId" }, { "$ref": "#/components/parameters/IfMatch" }], "responses": { "204": { "description": "缺陷已删除。" } }, "tags": ["issues"] },
    "listIssueEvents": { "operationId": "listIssueEvents", "summary": "列出状态历史", "description": "按时间返回缺陷事件。", "method": "GET", "path": "/issues/{issueId}/events", "consumes": [], "produces": ["application/json"], "parameters": [{ "$ref": "#/components/parameters/IssueId" }], "responses": { "200": { "description": "状态事件列表。" } }, "tags": ["issues"] },
    "claimIssue": { "operationId": "claimIssue", "summary": "原子认领缺陷", "description": "只有 open 缺陷能被一个调用方永久认领。", "method": "POST", "path": "/issues/{issueId}/claim", "consumes": ["application/json"], "produces": ["application/json"], "parameters": [{ "$ref": "#/components/parameters/IssueId" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "200": { "description": "认领成功。" }, "409": { "description": "缺陷已被认领。" } }, "tags": ["issues"] },
    "claimNextIssue": { "operationId": "claimNextIssue", "summary": "领取最早缺陷", "description": "原子领取项目中最早的 open 缺陷；没有任务时 issue 为 null。", "method": "POST", "path": "/issues/claim-next", "consumes": ["application/json"], "produces": ["application/json"], "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "200": { "description": "返回已领取缺陷或 null。" } }, "tags": ["issues"] },
    "releaseIssue": { "operationId": "releaseIssue", "summary": "释放缺陷", "description": "领取 Token 或网站账号将缺陷恢复为 open。", "method": "POST", "path": "/issues/{issueId}/release", "consumes": ["application/json"], "produces": ["application/json"], "parameters": [{ "$ref": "#/components/parameters/IssueId" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "200": { "description": "缺陷已释放。" }, "403": { "description": "不是领取方。" } }, "tags": ["issues"] },
    "completeIssue": { "operationId": "completeIssue", "summary": "完成缺陷", "description": "领取 Token 或网站账号写入完成状态与摘要。", "method": "POST", "path": "/issues/{issueId}/complete", "consumes": ["application/json"], "produces": ["application/json"], "parameters": [{ "$ref": "#/components/parameters/IssueId" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "200": { "description": "缺陷已完成。" }, "403": { "description": "不是领取方。" } }, "tags": ["issues"] },
    "reopenIssue": { "operationId": "reopenIssue", "summary": "重新打开缺陷", "description": "将 done 缺陷恢复为 open。", "method": "POST", "path": "/issues/{issueId}/reopen", "consumes": ["application/json"], "produces": ["application/json"], "parameters": [{ "$ref": "#/components/parameters/IssueId" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "200": { "description": "缺陷已重新打开。" } }, "tags": ["issues"] },

    "createAttachment": { "operationId": "createAttachment", "summary": "上传截图", "description": "上传不超过 2 MiB 的 PNG、JPEG 或 WebP。", "method": "POST", "path": "/attachments", "consumes": ["application/json"], "produces": ["application/json"], "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "201": { "description": "截图已私有保存。" }, "413": { "description": "截图过大。" } }, "tags": ["attachments"] },
    "downloadAttachment": { "operationId": "downloadAttachment", "summary": "读取截图", "description": "鉴权后流式读取私有截图。", "method": "GET", "path": "/attachments/{attachmentId}", "consumes": [], "produces": ["image/png", "image/jpeg", "image/webp"], "parameters": [{ "in": "path", "name": "attachmentId", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "截图字节。" }, "404": { "description": "截图不存在。" } }, "tags": ["attachments"] },

    "listWebhooks": { "operationId": "listWebhooks", "summary": "列出 Webhook", "description": "列出账号的 Webhook。", "method": "GET", "path": "/webhooks", "consumes": [], "produces": ["application/json"], "parameters": [], "responses": { "200": { "description": "Webhook 列表。" } }, "tags": ["webhooks"] },
    "createWebhook": { "operationId": "createWebhook", "summary": "创建 Webhook", "description": "创建只接收 issue.created 的公网 HTTPS Webhook。", "method": "POST", "path": "/webhooks", "consumes": ["application/json"], "produces": ["application/json"], "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "201": { "description": "Webhook 和只显示一次的 Secret。" }, "422": { "description": "URL 不安全。" } }, "tags": ["webhooks"] },
    "updateWebhook": { "operationId": "updateWebhook", "summary": "更新 Webhook", "description": "更新名称、URL 或启用状态。", "method": "PATCH", "path": "/webhooks/{webhookId}", "consumes": ["application/json"], "produces": ["application/json"], "parameters": [{ "$ref": "#/components/parameters/WebhookId" }, { "$ref": "#/components/parameters/IfMatch" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "200": { "description": "Webhook 已更新。" } }, "tags": ["webhooks"] },
    "deleteWebhook": { "operationId": "deleteWebhook", "summary": "删除 Webhook", "description": "删除 Webhook 和投递记录。", "method": "DELETE", "path": "/webhooks/{webhookId}", "consumes": [], "produces": [], "parameters": [{ "$ref": "#/components/parameters/WebhookId" }, { "$ref": "#/components/parameters/IfMatch" }], "responses": { "204": { "description": "Webhook 已删除。" } }, "tags": ["webhooks"] },
    "rotateWebhookSecret": { "operationId": "rotateWebhookSecret", "summary": "轮换 Secret", "description": "立即轮换 Webhook 签名 Secret。", "method": "POST", "path": "/webhooks/{webhookId}/rotate-secret", "consumes": ["application/json"], "produces": ["application/json"], "parameters": [{ "$ref": "#/components/parameters/WebhookId" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "200": { "description": "返回只显示一次的新 Secret。" } }, "tags": ["webhooks"] },
    "testWebhook": { "operationId": "testWebhook", "summary": "测试 Webhook", "description": "排队并立即尝试测试投递。", "method": "POST", "path": "/webhooks/{webhookId}/test", "consumes": ["application/json"], "produces": ["application/json"], "parameters": [{ "$ref": "#/components/parameters/WebhookId" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "202": { "description": "测试投递已创建。" } }, "tags": ["webhooks"] },
    "listWebhookDeliveries": { "operationId": "listWebhookDeliveries", "summary": "列出投递记录", "description": "返回最近的 Webhook 投递与错误。", "method": "GET", "path": "/webhooks/{webhookId}/deliveries", "consumes": [], "produces": ["application/json"], "parameters": [{ "$ref": "#/components/parameters/WebhookId" }], "responses": { "200": { "description": "投递记录列表。" } }, "tags": ["webhooks"] },
    "retryWebhookDelivery": { "operationId": "retryWebhookDelivery", "summary": "重试投递", "description": "人工重试指定投递。", "method": "POST", "path": "/webhooks/{webhookId}/deliveries/{deliveryId}/retry", "consumes": ["application/json"], "produces": ["application/json"], "parameters": [{ "$ref": "#/components/parameters/WebhookId" }, { "in": "path", "name": "deliveryId", "required": true, "schema": { "type": "string" } }, { "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "202": { "description": "投递已排队。" } }, "tags": ["webhooks"] },

    "listApiTokens": { "operationId": "listApiTokens", "summary": "列出 API Token", "description": "列出不含明文的 PAT 元数据。", "method": "GET", "path": "/tokens", "consumes": [], "produces": ["application/json"], "parameters": [], "responses": { "200": { "description": "Token 元数据列表。" } }, "tags": ["tokens"] },
    "createApiToken": { "operationId": "createApiToken", "summary": "创建 API Token", "description": "创建 ph_pat_ Token；明文只返回一次。", "method": "POST", "path": "/tokens", "consumes": ["application/json"], "produces": ["application/json"], "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "201": { "description": "Token 与固定自动化 Scopes。" } }, "tags": ["tokens"] },
    "revokeApiToken": { "operationId": "revokeApiToken", "summary": "撤销 API Token", "description": "立即撤销 PAT。", "method": "DELETE", "path": "/tokens/{tokenId}", "consumes": [], "produces": [], "parameters": [{ "in": "path", "name": "tokenId", "required": true, "schema": { "type": "string" } }], "responses": { "204": { "description": "Token 已撤销。" } }, "tags": ["tokens"] }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "description": "网站 Session、扩展 OAuth Token 或 ph_pat_ 自动化 Token。" }
    },
    "parameters": {
      "ProjectId": { "in": "path", "name": "projectId", "required": true, "schema": { "type": "string" } },
      "IssueId": { "in": "path", "name": "issueId", "required": true, "schema": { "type": "string" } },
      "WebhookId": { "in": "path", "name": "webhookId", "required": true, "schema": { "type": "string" } },
      "IfMatch": { "in": "header", "name": "If-Match", "required": true, "schema": { "type": "string", "description": "资源 version 对应的 ETag。" } },
      "IdempotencyKey": { "in": "header", "name": "Idempotency-Key", "required": false, "schema": { "type": "string", "minLength": 8, "maxLength": 200 } },
      "Cursor": { "in": "query", "name": "cursor", "required": false, "schema": { "type": "string" } }
    },
    "schemas": {
      "IssueStatus": { "type": "string", "enum": ["open", "in_progress", "done"], "description": "缺陷固定状态。" },
      "ProjectInput": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string", "maxLength": 100 }, "description": { "type": "string", "maxLength": 1000 }, "origins": { "type": "array", "items": { "type": "string", "format": "uri" } } } },
      "IssueInput": { "type": "object", "required": ["projectId", "title", "description", "pageUrl", "dom"], "properties": { "projectId": { "type": "string" }, "title": { "type": "string", "maxLength": 200 }, "description": { "type": "string", "maxLength": 20000 }, "pageUrl": { "type": "string", "format": "uri" }, "attachmentId": { "type": "string" }, "dom": { "type": "object", "description": "已清洗的 DOM、viewport 与元素矩形上下文。" } } },
      "Error": { "type": "object", "required": ["error"], "properties": { "error": { "type": "object", "required": ["code", "message", "requestId"], "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "requestId": { "type": "string" } } } } }
    }
  }
}
