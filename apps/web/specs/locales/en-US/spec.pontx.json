{
  "pontx": "2.1",
  "name": "pinhere-api",
  "style": "RESTFul",
  "info": {
    "title": "Pinhere API",
    "version": "1.0.0",
    "description": "Pinhere projects, issues, attachments and automation. Pontx Hub can consume this contract to publish the SDK, CLI and Skill."
  },
  "servers": [{ "id": "production", "url": "https://pinhere.dev/api/v1", "description": "Pinhere production API" }],
  "security": [{ "bearerAuth": [] }],
  "tags": [
    { "name": "projects", "description": "Projects and origin ownership" },
    { "name": "issues", "description": "Issues and the AI state machine" },
    { "name": "attachments", "description": "Private screenshots" },
    { "name": "webhooks", "description": "issue.created notifications" },
    { "name": "tokens", "description": "Automation credentials" }
  ],
  "apis": {
    "listProjects": { "operationId": "listProjects", "summary": "List projects", "description": "Lists every project owned by the current account.", "method": "GET", "path": "/projects", "consumes": [], "produces": ["application/json"], "parameters": [], "responses": { "200": { "description": "Project list." } }, "tags": ["projects"] },
    "createProject": { "operationId": "createProject", "summary": "Create project", "description": "Creates a personal project and optional origins.", "method": "POST", "path": "/projects", "consumes": ["application/json"], "produces": ["application/json"], "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }, { "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/components/schemas/ProjectInput" } }], "responses": { "201": { "description": "Project created." }, "409": { "description": "Origin belongs to another project." } }, "tags": ["projects"] },
    "getProject": { "operationId": "getProject", "summary": "Get project", "description": "Gets a project and its origins.", "method": "GET", "path": "/projects/{projectId}", "consumes": [], "produces": ["application/json"], "parameters": [{ "$ref": "#/components/parameters/ProjectId" }], "responses": { "200": { "description": "Project details." }, "404": { "description": "Project not found." } }, "tags": ["projects"] },
    "updateProject": { "operationId": "updateProject", "summary": "Update project", "description": "Updates a project using If-Match and version.", "method": "PATCH", "path": "/projects/{projectId}", "consumes": ["application/json"], "produces": ["application/json"], "parameters": [{ "$ref": "#/components/parameters/ProjectId" }, { "$ref": "#/components/parameters/IfMatch" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "200": { "description": "Project updated." }, "412": { "description": "Version conflict." } }, "tags": ["projects"] },
    "deleteProject": { "operationId": "deleteProject", "summary": "Delete project", "description": "Deletes the project, issues and screenshots.", "method": "DELETE", "path": "/projects/{projectId}", "consumes": [], "produces": [], "parameters": [{ "$ref": "#/components/parameters/ProjectId" }, { "$ref": "#/components/parameters/IfMatch" }], "responses": { "204": { "description": "Project deleted." } }, "tags": ["projects"] },
    "addProjectOrigin": { "operationId": "addProjectOrigin", "summary": "Add origin", "description": "Adds a normalized origin to a project.", "method": "POST", "path": "/projects/{projectId}/origins", "consumes": ["application/json"], "produces": ["application/json"], "parameters": [{ "$ref": "#/components/parameters/ProjectId" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "201": { "description": "Origin added." }, "409": { "description": "Origin is already assigned." } }, "tags": ["projects"] },
    "deleteProjectOrigin": { "operationId": "deleteProjectOrigin", "summary": "Delete origin", "description": "Removes a URL-encoded origin from the project.", "method": "DELETE", "path": "/projects/{projectId}/origins/{encodedOrigin}", "consumes": [], "produces": [], "parameters": [{ "$ref": "#/components/parameters/ProjectId" }, { "in": "path", "name": "encodedOrigin", "required": true, "schema": { "type": "string", "description": "URL-encoded normalized origin." } }], "responses": { "204": { "description": "Origin deleted." } }, "tags": ["projects"] },
    "resolveProject": { "operationId": "resolveProject", "summary": "Resolve project by URL", "description": "Compares only scheme, hostname and port.", "method": "GET", "path": "/projects/resolve", "consumes": [], "produces": ["application/json"], "parameters": [{ "in": "query", "name": "url", "required": true, "schema": { "type": "string", "format": "uri", "description": "Current page URL." } }], "responses": { "200": { "description": "Matched project or null." } }, "tags": ["projects"] },

    "listIssues": { "operationId": "listIssues", "summary": "List issues", "description": "Cursor-paginated list filtered by project, status or update time.", "method": "GET", "path": "/issues", "consumes": [], "produces": ["application/json"], "parameters": [{ "$ref": "#/components/parameters/Cursor" }, { "in": "query", "name": "projectId", "required": false, "schema": { "type": "string" } }, { "in": "query", "name": "status", "required": false, "schema": { "$ref": "#/components/schemas/IssueStatus" } }, { "in": "query", "name": "updatedAfter", "required": false, "schema": { "type": "string", "format": "date-time" } }], "responses": { "200": { "description": "Issue list." }, "304": { "description": "Content unchanged." } }, "tags": ["issues"] },
    "createIssue": { "operationId": "createIssue", "summary": "Create issue", "description": "Creates an issue and issue.created Outbox event in one transaction.", "method": "POST", "path": "/issues", "consumes": ["application/json"], "produces": ["application/json"], "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }, { "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/components/schemas/IssueInput" } }], "responses": { "201": { "description": "Issue created." }, "409": { "description": "Page origin does not match the project." } }, "tags": ["issues"] },
    "getIssue": { "operationId": "getIssue", "summary": "Get issue", "description": "Gets DOM, screenshot, target and state context.", "method": "GET", "path": "/issues/{issueId}", "consumes": [], "produces": ["application/json"], "parameters": [{ "$ref": "#/components/parameters/IssueId" }], "responses": { "200": { "description": "Complete issue context." }, "404": { "description": "Issue not found." } }, "tags": ["issues"] },
    "updateIssue": { "operationId": "updateIssue", "summary": "Update issue", "description": "Updates the issue title or description.", "method": "PATCH", "path": "/issues/{issueId}", "consumes": ["application/json"], "produces": ["application/json"], "parameters": [{ "$ref": "#/components/parameters/IssueId" }, { "$ref": "#/components/parameters/IfMatch" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "200": { "description": "Issue updated." }, "412": { "description": "Version conflict." } }, "tags": ["issues"] },
    "deleteIssue": { "operationId": "deleteIssue", "summary": "Delete issue", "description": "Deletes the issue, history and screenshot.", "method": "DELETE", "path": "/issues/{issueId}", "consumes": [], "produces": [], "parameters": [{ "$ref": "#/components/parameters/IssueId" }, { "$ref": "#/components/parameters/IfMatch" }], "responses": { "204": { "description": "Issue deleted." } }, "tags": ["issues"] },
    "listIssueEvents": { "operationId": "listIssueEvents", "summary": "List issue events", "description": "Returns issue events in chronological order.", "method": "GET", "path": "/issues/{issueId}/events", "consumes": [], "produces": ["application/json"], "parameters": [{ "$ref": "#/components/parameters/IssueId" }], "responses": { "200": { "description": "Issue event list." } }, "tags": ["issues"] },
    "claimIssue": { "operationId": "claimIssue", "summary": "Atomically claim issue", "description": "Only one caller can permanently claim an open issue.", "method": "POST", "path": "/issues/{issueId}/claim", "consumes": ["application/json"], "produces": ["application/json"], "parameters": [{ "$ref": "#/components/parameters/IssueId" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "200": { "description": "Claim succeeded." }, "409": { "description": "Issue is already claimed." } }, "tags": ["issues"] },
    "claimNextIssue": { "operationId": "claimNextIssue", "summary": "Claim oldest issue", "description": "Atomically claims the oldest open issue; issue is null when no work exists.", "method": "POST", "path": "/issues/claim-next", "consumes": ["application/json"], "produces": ["application/json"], "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "200": { "description": "Claimed issue or null." } }, "tags": ["issues"] },
    "releaseIssue": { "operationId": "releaseIssue", "summary": "Release issue", "description": "The claiming token or website account restores the issue to open.", "method": "POST", "path": "/issues/{issueId}/release", "consumes": ["application/json"], "produces": ["application/json"], "parameters": [{ "$ref": "#/components/parameters/IssueId" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "200": { "description": "Issue released." }, "403": { "description": "Caller did not claim this issue." } }, "tags": ["issues"] },
    "completeIssue": { "operationId": "completeIssue", "summary": "Complete issue", "description": "The claiming token or website account stores completion and summary.", "method": "POST", "path": "/issues/{issueId}/complete", "consumes": ["application/json"], "produces": ["application/json"], "parameters": [{ "$ref": "#/components/parameters/IssueId" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "200": { "description": "Issue completed." }, "403": { "description": "Caller did not claim this issue." } }, "tags": ["issues"] },
    "reopenIssue": { "operationId": "reopenIssue", "summary": "Reopen issue", "description": "Restores a done issue to open.", "method": "POST", "path": "/issues/{issueId}/reopen", "consumes": ["application/json"], "produces": ["application/json"], "parameters": [{ "$ref": "#/components/parameters/IssueId" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "200": { "description": "Issue reopened." } }, "tags": ["issues"] },

    "createAttachment": { "operationId": "createAttachment", "summary": "Upload screenshot", "description": "Uploads a PNG, JPEG or WebP no larger than 2 MiB.", "method": "POST", "path": "/attachments", "consumes": ["application/json"], "produces": ["application/json"], "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "201": { "description": "Screenshot stored privately." }, "413": { "description": "Screenshot is too large." } }, "tags": ["attachments"] },
    "downloadAttachment": { "operationId": "downloadAttachment", "summary": "Read screenshot", "description": "Streams a private screenshot after authorization.", "method": "GET", "path": "/attachments/{attachmentId}", "consumes": [], "produces": ["image/png", "image/jpeg", "image/webp"], "parameters": [{ "in": "path", "name": "attachmentId", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Screenshot bytes." }, "404": { "description": "Screenshot not found." } }, "tags": ["attachments"] },

    "listWebhooks": { "operationId": "listWebhooks", "summary": "List webhooks", "description": "Lists webhooks owned by the account.", "method": "GET", "path": "/webhooks", "consumes": [], "produces": ["application/json"], "parameters": [], "responses": { "200": { "description": "Webhook list." } }, "tags": ["webhooks"] },
    "createWebhook": { "operationId": "createWebhook", "summary": "Create webhook", "description": "Creates a public HTTPS webhook that receives issue.created.", "method": "POST", "path": "/webhooks", "consumes": ["application/json"], "produces": ["application/json"], "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "201": { "description": "Webhook and one-time secret." }, "422": { "description": "Unsafe URL." } }, "tags": ["webhooks"] },
    "updateWebhook": { "operationId": "updateWebhook", "summary": "Update webhook", "description": "Updates name, URL or enabled state.", "method": "PATCH", "path": "/webhooks/{webhookId}", "consumes": ["application/json"], "produces": ["application/json"], "parameters": [{ "$ref": "#/components/parameters/WebhookId" }, { "$ref": "#/components/parameters/IfMatch" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "200": { "description": "Webhook updated." } }, "tags": ["webhooks"] },
    "deleteWebhook": { "operationId": "deleteWebhook", "summary": "Delete webhook", "description": "Deletes the webhook and delivery records.", "method": "DELETE", "path": "/webhooks/{webhookId}", "consumes": [], "produces": [], "parameters": [{ "$ref": "#/components/parameters/WebhookId" }, { "$ref": "#/components/parameters/IfMatch" }], "responses": { "204": { "description": "Webhook deleted." } }, "tags": ["webhooks"] },
    "rotateWebhookSecret": { "operationId": "rotateWebhookSecret", "summary": "Rotate secret", "description": "Immediately rotates the webhook signing secret.", "method": "POST", "path": "/webhooks/{webhookId}/rotate-secret", "consumes": ["application/json"], "produces": ["application/json"], "parameters": [{ "$ref": "#/components/parameters/WebhookId" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "200": { "description": "New one-time secret." } }, "tags": ["webhooks"] },
    "testWebhook": { "operationId": "testWebhook", "summary": "Test webhook", "description": "Queues and immediately attempts a test delivery.", "method": "POST", "path": "/webhooks/{webhookId}/test", "consumes": ["application/json"], "produces": ["application/json"], "parameters": [{ "$ref": "#/components/parameters/WebhookId" }, { "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "202": { "description": "Test delivery created." } }, "tags": ["webhooks"] },
    "listWebhookDeliveries": { "operationId": "listWebhookDeliveries", "summary": "List deliveries", "description": "Returns recent webhook deliveries and errors.", "method": "GET", "path": "/webhooks/{webhookId}/deliveries", "consumes": [], "produces": ["application/json"], "parameters": [{ "$ref": "#/components/parameters/WebhookId" }], "responses": { "200": { "description": "Delivery list." } }, "tags": ["webhooks"] },
    "retryWebhookDelivery": { "operationId": "retryWebhookDelivery", "summary": "Retry delivery", "description": "Manually retries one delivery.", "method": "POST", "path": "/webhooks/{webhookId}/deliveries/{deliveryId}/retry", "consumes": ["application/json"], "produces": ["application/json"], "parameters": [{ "$ref": "#/components/parameters/WebhookId" }, { "in": "path", "name": "deliveryId", "required": true, "schema": { "type": "string" } }, { "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "202": { "description": "Delivery queued." } }, "tags": ["webhooks"] },

    "listApiTokens": { "operationId": "listApiTokens", "summary": "List API tokens", "description": "Lists PAT metadata without plaintext secrets.", "method": "GET", "path": "/tokens", "consumes": [], "produces": ["application/json"], "parameters": [], "responses": { "200": { "description": "Token metadata list." } }, "tags": ["tokens"] },
    "createApiToken": { "operationId": "createApiToken", "summary": "Create API token", "description": "Creates a ph_pat_ token; plaintext is returned once.", "method": "POST", "path": "/tokens", "consumes": ["application/json"], "produces": ["application/json"], "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }], "responses": { "201": { "description": "Token with fixed automation scopes." } }, "tags": ["tokens"] },
    "revokeApiToken": { "operationId": "revokeApiToken", "summary": "Revoke API token", "description": "Immediately revokes a PAT.", "method": "DELETE", "path": "/tokens/{tokenId}", "consumes": [], "produces": [], "parameters": [{ "in": "path", "name": "tokenId", "required": true, "schema": { "type": "string" } }], "responses": { "204": { "description": "Token revoked." } }, "tags": ["tokens"] }
  },
  "components": {
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer", "description": "Website session, extension OAuth token or ph_pat_ automation token." } },
    "parameters": {
      "ProjectId": { "in": "path", "name": "projectId", "required": true, "schema": { "type": "string" } },
      "IssueId": { "in": "path", "name": "issueId", "required": true, "schema": { "type": "string" } },
      "WebhookId": { "in": "path", "name": "webhookId", "required": true, "schema": { "type": "string" } },
      "IfMatch": { "in": "header", "name": "If-Match", "required": true, "schema": { "type": "string", "description": "ETag for the resource version." } },
      "IdempotencyKey": { "in": "header", "name": "Idempotency-Key", "required": false, "schema": { "type": "string", "minLength": 8, "maxLength": 200 } },
      "Cursor": { "in": "query", "name": "cursor", "required": false, "schema": { "type": "string" } }
    },
    "schemas": {
      "IssueStatus": { "type": "string", "enum": ["open", "in_progress", "done"], "description": "Fixed issue state." },
      "ProjectInput": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string", "maxLength": 100 }, "description": { "type": "string", "maxLength": 1000 }, "origins": { "type": "array", "items": { "type": "string", "format": "uri" } } } },
      "IssueInput": { "type": "object", "required": ["projectId", "title", "description", "pageUrl", "dom"], "properties": { "projectId": { "type": "string" }, "title": { "type": "string", "maxLength": 200 }, "description": { "type": "string", "maxLength": 20000 }, "pageUrl": { "type": "string", "format": "uri" }, "attachmentId": { "type": "string" }, "dom": { "type": "object", "description": "Sanitized DOM, viewport and element rectangle context." } } },
      "Error": { "type": "object", "required": ["error"], "properties": { "error": { "type": "object", "required": ["code", "message", "requestId"], "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "requestId": { "type": "string" } } } } }
    }
  }
}
