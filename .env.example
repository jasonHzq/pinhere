# Shared public URLs
PINHERE_BASE_URL=http://localhost:5173

# Public traffic analytics (GA4 destination Measurement ID)
VITE_GOOGLE_ANALYTICS_ID=
# Google tag ID that owns the connected GA4 destination.
VITE_GOOGLE_TAG_ID=

# Web database and authentication
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
RESEND_API_KEY=
EMAIL_FROM=Pinhere <auth@pinhere.dev>

# Private screenshot storage
BLOB_READ_WRITE_TOKEN=

# Async human-readable issue IDs (Alibaba Cloud Model Studio, OpenAI-compatible API)
QWEN_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_MODEL=qwen3.5-flash

# Vercel Cron requests
CRON_SECRET=

# Development-only identity. Never configure in production.
PINHERE_DEV_USER_ID=dev_user
